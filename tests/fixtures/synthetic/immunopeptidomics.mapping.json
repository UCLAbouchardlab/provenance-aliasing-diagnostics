{
  "schema_version": "0.1-draft",
  "name": "synthetic-immunopeptidomics",
  "columns": {
    "source": [
      "study_id"
    ],
    "unit": [
      "study_id",
      "specimen_id"
    ],
    "group": [
      "condition"
    ]
  },
  "grain": {
    "name": "study",
    "description": "Synthetic contributing study; specimen and donor identifiers are local to each study."
  },
  "unit_description": "A biological specimen within a synthetic study; peptide and technical-run records are not expanded.",
  "weighting": {
    "mode": "incidence"
  },
  "hierarchy": {
    "donor": [
      "study_id",
      "donor_id"
    ]
  },
  "policies": {
    "missing_required": "error",
    "duplicates": "error",
    "missing_parent": "report",
    "missing_tokens": []
  },
  "diagnostics": {
    "include": [
      "design",
      "entropy",
      "ceiling",
      "structure",
      "guards"
    ],
    "bootstrap_replicates": 0,
    "seed": 0
  },
  "execution": {
    "max_working_memory_mb": 512
  }
}

